flowchart TD
    START(["Begin propagation"]) --> SEED

    SEED["Seed source flows:\npropagated cost = own cost\nmark calculated"] --> SWEEP

    SWEEP["Start new sweep\nover all flows"] --> NEXT["Pick next\nuncalculated flow"]

    NEXT --> DONE{"All flows\ncalculated?"}
    DONE -- Yes --> FINISH(["Done"])

    DONE -- No --> ISCALC{"Already\ncalculated?"}
    ISCALC -- Yes --> NEXT

    ISCALC -- No --> READY{"Are all\nupstream inputs\ncalculated?"}

    READY -- No --> NEXT

    READY -- Yes --> DISPATCH{"Flow type?"}

    DISPATCH -- "Source flow\nalready seeded" --> NEXT

    DISPATCH -- "Circular\ninternal" --> CIRC_INT["Own cost only\nno upstream\nmark calculated"]
    CIRC_INT --> NEXT

    DISPATCH -- "Circular\noutflow" --> CIRC_OUT{"All cycle internal\nflows and inflows\ncalculated?"}
    CIRC_OUT -- No --> NEXT
    CIRC_OUT -- Yes --> CIRC_PROP["Pool internal own costs\n+ inflow propagated costs\ndistribute to outflows\nproportionally to energy\nmark calculated"]
    CIRC_PROP --> NEXT

    DISPATCH -- "Storage\ndischarge" --> STOR{"Charging flow\ncalculated?"}
    STOR -- No --> NEXT
    STOR -- Yes --> STOR_PROP["Track running cost account:\ncharge adds inflow cost\ndischarge inherits\naccount specific cost\nmark calculated"]
    STOR_PROP --> NEXT

    DISPATCH -- "Normal flow" --> GEN_PROP["weight = flow / total outflow\nfrom source node\ninherit upstream cost * weight\n+ own cost\nmark calculated"]
    GEN_PROP --> NEXT

    NEXT --> PROGRESS{"Made any\nprogress\nthis sweep?"}
    PROGRESS -- Yes --> SWEEP
    PROGRESS -- No --> CONVERGE["Log warning:\nDid not converge"]
    CONVERGE --> FINISH
